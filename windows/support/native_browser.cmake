# The support page uses native HWND browser windows. WebView plugin 0.6.0
# still eagerly creates a process-static capture compositor/DispatcherQueue;
# its DLL teardown can access CoreMessaging after COM shutdown. Compile a
# project-local copy without the unused capture initialization. Never edit
# Pub Cache or the original dependency sources.
set(_support_plugin flutter_inappwebview_windows_plugin)
if(TARGET ${_support_plugin})
  get_target_property(_support_plugin_dir ${_support_plugin} SOURCE_DIR)
  get_target_property(_support_sources ${_support_plugin} SOURCES)
  set(_support_manager "${_support_plugin_dir}/in_app_webview/in_app_webview_manager.cpp")
  file(READ "${_support_manager}" _support_original)
  string(FIND "${_support_original}" "    if (!rohelper_) {" _support_start)
  string(FIND "${_support_original}" "    windowClass_.lpszClassName" _support_end)
  if(_support_start LESS 0 OR _support_end LESS _support_start)
    message(FATAL_ERROR "WebView plugin changed: review the native support browser compatibility shim.")
  endif()
  string(SUBSTRING "${_support_original}" 0 ${_support_start} _support_prefix)
  string(SUBSTRING "${_support_original}" ${_support_end} -1 _support_suffix)
  set(_support_patched "${_support_prefix}    // Native support windows do not need a capture compositor.\n${_support_suffix}")
  set(_support_copy "${CMAKE_CURRENT_BINARY_DIR}/bettbox_support/in_app_webview_manager.cpp")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/bettbox_support")
  set(_support_current "")
  if(EXISTS "${_support_copy}")
    file(READ "${_support_copy}" _support_current)
  endif()
  if(NOT _support_current STREQUAL _support_patched)
    file(WRITE "${_support_copy}" "${_support_patched}")
  endif()
  set(_support_replaced 0)
  set(_support_updated_sources "")
  foreach(_support_source IN LISTS _support_sources)
    if(_support_source MATCHES "(^|/)in_app_webview/in_app_webview_manager\\.cpp$")
      list(APPEND _support_updated_sources "${_support_copy}")
      math(EXPR _support_replaced "${_support_replaced} + 1")
    else()
      list(APPEND _support_updated_sources "${_support_source}")
    endif()
  endforeach()
  if(NOT _support_replaced EQUAL 1)
    message(FATAL_ERROR "Cannot locate the WebView plugin manager compilation unit.")
  endif()
  set_property(TARGET ${_support_plugin} PROPERTY SOURCES "${_support_updated_sources}")
  target_include_directories(${_support_plugin} PRIVATE "${_support_plugin_dir}/in_app_webview")
endif()
